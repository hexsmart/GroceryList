@model List<GroceryList.Models.SharedList>
@inject GroceryList.Services.UserService UserService
@{
    ViewData["Title"] = "Manage Shared Lists";
    var userId = Context.Session.GetString("UserId");
}

<div class="container mt-4">
    <h2>🤝 Manage Shared Lists</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Success!</strong> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error!</strong> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Create New Shared List -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">➕ Create New Shared List</h5>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" class="row g-3">
                <div class="col-md-8">
                    <input type="text" name="listName" class="form-control" placeholder="Enter list name (e.g., Family Groceries)" required />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary w-100">Create List</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Existing Shared Lists -->
    @if (Model.Any())
    {
        <h4 class="mb-3">Your Shared Lists (@Model.Count)</h4>
        @foreach (var list in Model)
        {
            var isOwner = list.OwnerId.ToString() == userId;
            var allUsers = UserService.GetAll();
            var owner = allUsers.FirstOrDefault(u => u.Id == list.OwnerId);
            var members = allUsers.Where(u => list.MemberIds.Contains(u.Id)).ToList();

            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        📋 @list.Name
                        @if (isOwner)
                        {
                            <span class="badge bg-success">Owner</span>
                        }
                        else
                        {
                            <span class="badge bg-info">Member</span>
                        }
                    </h5>
                    <div>
                        @if (isOwner)
                        {
                            <button class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#renameModal-@list.Id">✏️ Rename</button>
                            <button class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@list.Id">🗑️ Delete</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-secondary" data-bs-toggle="modal" data-bs-target="#leaveModal-@list.Id">🚪 Leave</button>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <p class="mb-2"><strong>Owner:</strong> @(owner != null ? $"{owner.FirstName} {owner.LastName} ({owner.Email})" : "Unknown")</p>
                    <p class="mb-2"><strong>Created:</strong> @list.CreatedDate.ToString("MMMM dd, yyyy")</p>

                    <h6 class="mt-3">Members (@members.Count):</h6>
                    @if (members.Any())
                    {
                        <ul class="list-group">
                            @foreach (var member in members)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    @member.FirstName @member.LastName (@member.Email)
                                    @if (isOwner)
                                    {
                                        <form asp-action="RemoveMember" method="post" class="d-inline">
                                            <input type="hidden" name="listId" value="@list.Id" />
                                            <input type="hidden" name="memberId" value="@member.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Remove this member?')">✕</button>
                                        </form>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted">No members yet. Invite someone to share this list!</p>
                    }

                    @if (isOwner)
                    {
                        <div class="mt-3">
                            <h6>➕ Add Member:</h6>
                            <form asp-action="AddMember" method="post" class="row g-2">
                                <input type="hidden" name="listId" value="@list.Id" />
                                <div class="col-md-8">
                                    <input type="email" name="memberEmail" class="form-control" placeholder="Enter email address" required />
                                </div>
                                <div class="col-md-4">
                                    <button type="submit" class="btn btn-success w-100">Add</button>
                                </div>
                            </form>
                        </div>
                    }
                </div>
            </div>

            <!-- Rename Modal -->
            <div class="modal fade" id="renameModal-@list.Id" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Rename List</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <form asp-action="Rename" method="post">
                            <div class="modal-body">
                                <input type="hidden" name="listId" value="@list.Id" />
                                <div class="mb-3">
                                    <label for="newName-@list.Id" class="form-label">New Name:</label>
                                    <input type="text" id="newName-@list.Id" name="newName" class="form-control" value="@list.Name" required />
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-primary">Save Changes</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Delete Modal -->
            <div class="modal fade" id="deleteModal-@list.Id" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Delete Shared List</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <p>Are you sure you want to delete <strong>@list.Name</strong>?</p>
                            <p class="text-danger">This action cannot be undone. All items in this list will be permanently deleted.</p>
                        </div>
                        <form asp-action="Delete" method="post">
                            <input type="hidden" name="listId" value="@list.Id" />
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-danger">Delete List</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Leave Modal -->
            <div class="modal fade" id="leaveModal-@list.Id" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Leave Shared List</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <p>Are you sure you want to leave <strong>@list.Name</strong>?</p>
                            <p>You will no longer have access to this list unless the owner invites you again.</p>
                        </div>
                        <form asp-action="Leave" method="post">
                            <input type="hidden" name="listId" value="@list.Id" />
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-warning">Leave List</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info">
            <p class="mb-0">You don't have any shared lists yet. Create one above to start collaborating!</p>
        </div>
    }

    <div class="mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">← Back to Grocery List</a>
    </div>
</div>
