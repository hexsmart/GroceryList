@{
    ViewData["Title"] = "Shop";
    var categoryOrder = ViewBag.CategoryOrder as List<string> ?? new List<string>();
    var categoryOrderJson = System.Text.Json.JsonSerializer.Serialize(categoryOrder);
}

<style>
    .list-group-item.selected {
        background-color: #dee2e6;
        color: #6c757d;
    }
    .category-items.collapsed {
        display: none;
    }
</style>

<h1 class="mb-4">🧺 In My Cart</h1>

<div id="empty-msg" class="text-muted" style="display:none">No items in your cart. Go select some from the <a href="/">Grocery List</a>!</div>

<div id="shop-controls" class="mb-3 d-flex gap-2" style="display:none !important">
    <button class="btn btn-outline-secondary" id="view-toggle-btn" onclick="toggleViewMode()">📋 Flat View</button>
    <button class="btn btn-success" onclick="copyListToClipboard(this)">📋 Copy List</button>
</div>

<div id="category-container"></div>
<ul class="list-group mb-3" id="flat-list" style="display:none"></ul>

<button id="clear-all-btn" class="btn btn-warning mt-2" onclick="clearAll()" style="display:none">🗑️ Clear All</button>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.3/Sortable.min.js"></script>
<script>
    // Pass savedOrder to shop.js from ViewBag
    const savedOrder = @Html.Raw(categoryOrderJson);
</script>
<script src="~/js/shop.js" asp-append-version="true"></script>

