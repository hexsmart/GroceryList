@model GroceryList.Models.StoreViewModel
@using GroceryList.Helpers
@{
    ViewData["Title"] = "Store";
    var categoryOrder = ViewBag.CategoryOrder as List<string> ?? new List<string>();
    var categoryOrderJson = System.Text.Json.JsonSerializer.Serialize(categoryOrder);
    var grouped = Model.StoreItems.GroupBy(i => i.Category).ToList();
    var orderedGroups = grouped
        .OrderBy(g => {
            var idx = categoryOrder.IndexOf(g.Key);
            return idx == -1 ? int.MaxValue : idx;
        })
        .ThenBy(g => g.Key)
        .ToList();
}

<h1 class="mb-3">🏪 Store</h1>

<div class="mb-3">
    <button class="btn btn-outline-secondary btn-sm" onclick="expandCollapseAll()">
        <span id="expand-collapse-label">🔽 Collapse All</span>
    </button>
</div>

<div id="store-container">
    @foreach (var group in orderedGroups)
    {
        var catId = group.Key.Replace(" ", "-");
        <div class="mb-3" data-category="@group.Key">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="drag-handle text-muted me-1" style="cursor:grab" title="Drag to reorder">⠿</span>
                <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none fw-bold fs-5 text-dark"
                        onclick="toggleCollapse('@catId')">
                    <span id="chevron-@catId">▾</span> @group.Key
                    <span class="badge bg-secondary ms-1">@group.Count()</span>
                </button>
            </div>
            <div id="items-@catId" class="category-items">
                <ul class="list-group mb-2">
                    @foreach (var item in group)
                    {
                        var already = Model.ExistingItems.Contains(item.Name);
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span class="fw-semibold">@item.Emoji @item.Name</span>
                            @if (already)
                            {
                                <span class="badge bg-success" id="badge-@item.Name.Replace(" ", "-")">✅ Added</span>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-primary" id="badge-@item.Name.Replace(" ", "-")"
                                        onclick="addItem(this, '@item.Name')">➕ Add</button>
                            }
                        </li>
                    }
                </ul>
            </div>
        </div>
    }
</div>

<style>
    .category-items.collapsed { display: none; }
    #store-container > div { border-left: 3px solid transparent; }
    #store-container > div.sortable-ghost { opacity: 0.4; }
</style>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.3/Sortable.min.js"></script>
<script src="~/js/store.js" asp-append-version="true"></script>

